#!/usr/bin/python3 -IB
"""Helper đặc quyền của TT_UbuntuTools — chỉ được gọi qua pkexec.

Hành động (nhiều hành động trong một lần xác thực được ngăn cách bằng '::'):

  apt-remove   <gói> [--purge] [--autoremove] --expect <gói1,gói2,...>
  snap-remove  <snap> [--purge]
  rm-path      <đường_dẫn>
  pip-remove   <tên> --site /usr/local/lib/python3.N/dist-packages
  npm-remove   <tên> --prefix <thư_mục_npm_toàn_cục>

Nguyên tắc an toàn:
  * Kiểm tra cú pháp TẤT CẢ hành động trước, rồi kiểm tra an toàn (mô phỏng apt, luật bảo vệ,
    luật đường dẫn) cho TẤT CẢ trước khi thực hiện bất cứ thứ gì.
  * apt: chỉ gỡ khi tập gói mô phỏng ngay lúc này KHỚP ĐÚNG tập người dùng đã xem trước (--expect),
    không có gói nào bị cài thêm, và không gói nào vi phạm luật bảo vệ.
  * Output của apt/dpkg được helper chuyển tiếp; nếu giao diện bị đóng giữa chừng, helper vẫn đọc
    hết output (ghi vào /var/log/tt-ubuntutools/) để dpkg không bao giờ bị ngắt giữa chừng.

Mã thoát: 0 ok · 2 tham số sai · 3 không phải root · 5 kiểm tra an toàn thất bại (chưa làm gì)
          · 6 lỗi trong lúc thực hiện (có thể đã làm được một phần — xem các dòng TT-JOB-DONE).
"""

import errno
import fcntl
import os
import re
import secrets
import select
import signal
import subprocess
import sys
import time

sys.dont_write_bytecode = True  # chạy bằng root: không ghi __pycache__

MARKER = "TT-HELPER-START"
NONCE = secrets.token_hex(8)  # chống giả mạo dòng TT-JOB-DONE từ output của lệnh con
SEPARATOR = "::"
EXIT_USAGE, EXIT_NOT_ROOT, EXIT_TOOL, EXIT_SAFETY, EXIT_RUN = 2, 3, 4, 5, 6
JOB_DONE = "TT-JOB-DONE"
DEV_FLAG = "--dev-allow-user-code"

APT_NAME = re.compile(r"[a-z0-9](?:[a-z0-9+.\-]*[a-z0-9+])?(?::[a-z0-9\-]+)?")  # dùng fullmatch
SNAP_NAME = re.compile(r"[a-z0-9](?:[a-z0-9\-]{0,38}[a-z0-9])?")
PIP_NAME = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9._\-]{0,198}[A-Za-z0-9])?")
NPM_NAME = re.compile(r"(@[a-z0-9][a-z0-9._~\-]*/)?[A-Za-z0-9][A-Za-z0-9._~\-]{0,213}")  # gói cũ có chữ hoa
PIP_SITE = re.compile(r"/usr/local/lib/python3\.(\d{1,2})/dist-packages")
SIM_RE = re.compile(r"^(Remv|Purg|Inst|Conf) (\S+)")

ENV = {
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "DEBIAN_FRONTEND": "noninteractive",
    "HOME": "/root",
}
LOG_DIR = "/var/log/tt-ubuntutools"
APT_GET, DPKG_QUERY, SNAP = "/usr/bin/apt-get", "/usr/bin/dpkg-query", "/usr/bin/snap"
DPKG_FRONTEND_LOCK = "/var/lib/dpkg/lock-frontend"
LOCK_HELD = False  # FrontendLock đang giữ khoá frontend của dpkg

